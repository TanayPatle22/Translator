            "text": "\u0915\u0948\u0902\u0938\u0930, \u0915\u0948\u0902\u0938\u0930 \u0915\u093e \u0928\u093f\u0926\u093e\u0928 \u092f\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u093e, \u0938\u094d\u0924\u0928 \u0915\u0948\u0902\u0938\u0930, \u092e\u0938\u094d\u0924\u093f\u0937\u094d\u0915 \u091f\u094d\u092f\u0942\u092e\u0930 \u092f\u093e \u0915\u0948\u0902\u0938\u0930, \u092e\u094c\u0916\u093f\u0915 \u0915\u0948\u0902\u0938\u0930 \u092f\u093e \u0921\u093f\u0938\u092a\u094d\u0932\u0947\u0938\u093f\u092f\u093e, \u0924\u094d\u0935\u091a\u093e \u0915\u0948\u0902\u0938\u0930 \u092f\u093e \u092e\u0947\u0932\u0947\u0928\u094b\u092e\u093e, \u0917\u0930\u094d\u092d\u093e\u0936\u092f \u0917\u094d\u0930\u0940\u0935\u093e \u0915\u0948\u0902\u0938\u0930, \u0938\u094c\u092e\u094d\u092f \u090a\u0924\u0915 \u092f\u093e \u0918\u093e\u0924\u0915 \u090a\u0924\u0915, \u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u092f\u093e \u0917\u0939\u0928 \u0936\u093f\u0915\u094d\u0937\u0923, \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u092f\u093e \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923\u0964",
