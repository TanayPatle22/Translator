        {
            "type": "text",
            "bbox": [
                78.50399780273438,
                430.8186950683594,
                571.9483032226562,
                574.2672729492188
            ],
            "text": "\u0907\u0938 \u0905\u0927\u094d\u092f\u092f\u0928 \u092e\u0947\u0902 \u0939\u092e\u0928\u0947 \u091c\u093f\u0928 \u0915\u0948\u0902\u0938\u0930\u094b\u0902 \u0915\u094b \u0932\u093f\u092f\u093e \u0939\u0948 \u0935\u0947 \u0938\u092c\u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u094d\u0930\u091a\u0932\u093f\u0924 \u0914\u0930 \u0918\u093e\u0924\u0915 \u0915\u0948\u0902\u0938\u0930 \u0939\u0948\u0902\u0964 \u0928\u093f\u0926\u093e\u0928 \u0915\u093f\u090f \u0917\u090f \u0932\u0917\u092d\u0917 70% \u0938\u0947 \u0905\u0927\u093f\u0915 \u0915\u0948\u0902\u0938\u0930 \u0907\u0928 \u092a\u093e\u0902\u091a \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0928 \u0915\u0948\u0902\u0938\u0930\u094b\u0902 \u092e\u0947\u0902 \u092e\u0943\u0924\u094d\u092f\u0941 \u0926\u0930 \u0905\u0927\u093f\u0915 \u0939\u094b\u0924\u0940 \u0939\u0948 \u0914\u0930 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u092c\u093e\u0926 \u0915\u0947 \u091a\u0930\u0923\u094b\u0902 \u092e\u0947\u0902 \u0907\u0938\u0915\u093e \u0928\u093f\u0926\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092a\u093f\u091b\u0932\u0947 \u0926\u0936\u0915 \u0915\u0947 \u0936\u094b\u0927 \u0938\u0947 \u092a\u0924\u093e \u091a\u0932\u0924\u093e \u0939\u0948 \u0915\u093f \u0907\u0928 \u0915\u0948\u0902\u0938\u0930\u094b\u0902 \u0915\u093e \u0936\u0940\u0918\u094d\u0930 \u092a\u0924\u093e \u0932\u0917\u0928\u0947 \u0938\u0947 \u092e\u0943\u0924\u094d\u092f\u0941 \u0926\u0930 \u0914\u0930 \u0930\u094b\u0917\u093f\u092f\u094b\u0902 \u0915\u0940 \u091c\u0940\u0935\u093f\u0924 \u0930\u0939\u0928\u0947 \u0915\u0940 \u0926\u0930 \u092e\u0947\u0902 \u0915\u093e\u092b\u0940 \u0915\u092e\u0940 \u0906 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0930\u0941\u091d\u093e\u0928\u094b\u0902 \u0938\u0947 \u092a\u0924\u093e \u091a\u0932\u0924\u093e \u0939\u0948 \u0915\u093f \u0936\u094b\u0927\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0928\u0947 \u092e\u0947\u0921\u093f\u0915\u0932 \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0924\u094c\u0930-\u0924\u0930\u0940\u0915\u094b\u0902 \u0915\u0940 \u092e\u0926\u0926 \u0938\u0947 \u0907\u0928 \u0915\u0948\u0902\u0938\u0930\u094b\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0914\u0930 \u0928\u093f\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092c\u0939\u0941\u0924 \u0915\u093e\u092e \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0938\u093e\u0925 \u0939\u0940, \u0907\u0928 \u0936\u094b\u0927\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0928\u0947 \u0907\u0928 \u0915\u0948\u0902\u0938\u0930\u094b\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0914\u0930 \u0928\u093f\u0926\u093e\u0928 \u0938\u0947 \u091c\u0941\u0921\u093c\u0940 \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u0915\u094b \u0926\u0942\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0928\u0935\u0940\u0928 \u0914\u0930 \u0938\u0902\u0936\u094b\u0927\u093f\u0924 \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0924\u0930\u0940\u0915\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0926\u093f\u092f\u093e \u0939\u0948\u0964 \u091c\u093e\u0939\u093f\u0930\u093e \u0924\u094c\u0930 \u092a\u0930, \u0939\u092e\u0947\u0902 \u0915\u0948\u0902\u0938\u0930 \u092a\u0930 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0901 \u092e\u093f\u0932\u0940\u0902, \u0932\u0947\u0915\u093f\u0928 \u0926\u0941\u0930\u094d\u092d\u093e\u0917\u094d\u092f \u0938\u0947 \u0939\u092e\u0928\u0947 \u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0914\u0930 \u0917\u0939\u0928 \u0936\u093f\u0915\u094d\u0937\u0923 \u0924\u0915\u0928\u0940\u0915\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0915\u0948\u0902\u0938\u0930 \u0915\u0940 \u091b\u0935\u093f-\u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u0928\u093f\u0926\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0915\u094b\u0908 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0928\u0939\u0940\u0902 \u0926\u0947\u0916\u0940\u0964 \u0907\u0938 \u0936\u094b\u0927 \u092a\u0924\u094d\u0930 \u092e\u0947\u0902 \u0939\u092e \u0909\u0928 \u0938\u092c\u0938\u0947 \u092a\u094d\u0930\u092e\u0941\u0916 \u0936\u094b\u0927 \u0932\u0947\u0916\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u0948\u0902\u0938\u0930 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0914\u0930 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u092e\u0947\u0921\u093f\u0915\u0932 \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0921\u0947\u091f\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u0939\u0948 \u0924\u093e\u0915\u093f \u0907\u0928 \u0936\u094b\u0927\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u0947 \u0915\u093e\u092e \u0915\u093e \u0909\u0928\u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u091a\u0941\u0928\u094c\u0924\u093f\u092f\u094b\u0902 \u0914\u0930 \u0909\u0928\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u090f \u0917\u090f \u0938\u092e\u093e\u0927\u093e\u0928 \u092f\u093e \u092d\u0935\u093f\u0937\u094d\u092f \u0915\u0947 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u0938\u0902\u0926\u0930\u094d\u092d \u092e\u0947\u0902 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0947\u0964",
