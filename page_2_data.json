            "text": "\u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 \u0938\u0940\u090f\u0921\u0940 \u0915\u093e \u090f\u0915 \u0932\u0902\u092c\u093e \u0907\u0924\u093f\u0939\u093e\u0938 \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0939\u093e\u0932 \u0939\u0940 \u092e\u0947\u0902 \u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0914\u0930 \u0921\u0940\u092a \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u091c\u0948\u0938\u0940 \u0928\u0908 \u0915\u0943\u0924\u094d\u0930\u093f\u092e \u092c\u0941\u0926\u094d\u0927\u093f\u092e\u0924\u094d\u0924\u093e \u0924\u0915\u0928\u0940\u0915\u094b\u0902 \u0915\u0947 \u0906\u0917\u092e\u0928 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0938\u0940\u090f\u0921\u0940 \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u091c\u0940\u0935\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915 \u092e\u0936\u0940\u0928 \u0938\u0940\u0916\u0928\u0947 \u0915\u0947 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u091b\u0935\u093f \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0939\u093e\u0925 \u0938\u0947 \u0924\u0948\u092f\u093e\u0930 \u092b\u0940\u091a\u0930 \u0928\u093f\u0937\u094d\u0915\u0930\u094d\u0937\u0923 \u0914\u0930 \u091a\u092f\u0928 \u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u0940 \u092e\u0926\u0926 \u0938\u0947 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u092f\u0939 \u0926\u0943\u0937\u094d\u091f\u093f\u0915\u094b\u0923 \u092e\u0941\u0916\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u0915\u0947\u0935\u0932 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e \u0915\u0947 \u0915\u094c\u0936\u0932 \u0914\u0930 \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u0924\u093e \u092a\u0930 \u0928\u093f\u0930\u094d\u092d\u0930 \u0925\u093e\u0964 \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0924\u0915\u0928\u0940\u0915 \u0915\u0947 \u0906\u0917\u092e\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0940\u091f\u0940 \u0938\u094d\u0915\u0948\u0928, \u090f\u092e\u0906\u0930\u0906\u0908, \u092e\u0948\u092e\u094b\u0917\u094d\u0930\u093e\u092b\u0940, \u0915\u094b\u0932\u094d\u092a\u094b\u0938\u094d\u0915\u094b\u092a\u0940, \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u0938\u094d\u0915\u094b\u092a\u093f\u0915 \u0907\u092e\u0947\u091c\u093f\u0902\u0917, \u092b\u094d\u0932\u094b\u0930\u094b\u0938\u0947\u0902\u091f \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0906\u0926\u093f \u091c\u0948\u0938\u0940 \u092e\u0947\u0921\u093f\u0915\u0932 \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0915\u0947 \u0909\u092a\u092f\u094b\u0917 \u0928\u0947 \u090f\u0932\u094d\u0917\u094b\u0930\u093f\u0926\u092e \u0915\u0940 \u090f\u0915 \u0928\u0908 \u092a\u0940\u0922\u093c\u0940 \u0915\u094b \u091c\u0928\u094d\u092e \u0926\u093f\u092f\u093e \u091c\u093f\u0938\u0947 \u0917\u0939\u0928 \u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u091c\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0915\u0908 \u0938\u0940\u090f\u0928\u090f\u0928 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935 \u092e\u0947\u0902 \u0906\u090f \u091c\u093f\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u092b\u0940\u091a\u0930 \u0928\u093f\u0937\u094d\u0915\u0930\u094d\u0937\u0923 \u0915\u0940 \u092e\u0942\u0932\u092d\u0942\u0924 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u094b \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0930\u0942\u092a \u0938\u0947 \u0939\u0932 \u0915\u093f\u092f\u093e, \u0917\u0939\u0928 \u0936\u093f\u0915\u094d\u0937\u0923 \u091b\u0935\u093f\u092f\u094b\u0902 \u0938\u0947 \u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e \u092b\u0940\u091a\u0930 \u0928\u093f\u0915\u093e\u0932\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0939\u0948\u0964 \u092e\u0947\u0921\u093f\u0915\u0932 \u0907\u092e\u0947\u091c \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0938\u0940\u090f\u0928\u090f\u0928 \u0915\u0940 \u0915\u094d\u0930\u093e\u0902\u0924\u093f \u0915\u093e \u0905\u0928\u0941\u092e\u093e\u0928 \u0907\u0938 \u0924\u0925\u094d\u092f \u0938\u0947 \u0932\u0917\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u092e\u0947\u0921\u093f\u0915\u0932 \u0907\u092e\u0947\u091c \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0938\u0948\u0915\u0921\u093c\u094b\u0902 \u0938\u0940\u090f\u0928\u090f\u0928 \u0939\u0948\u0902, \u091c\u0948\u0938\u0947, \u090f\u092e\u090f\u0928\u090f\u090f\u0938 \u0928\u0947\u091f, \u0906\u0930\u0908\u091f\u0940 \u0928\u0947\u091f, \u090f\u092e\u090f\u092c\u0940\u090f\u090f\u0932, \u092f\u0942 \u0928\u0947\u091f \u0906\u0926\u093f\u0964 \u0921\u0940\u092a \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0915\u094b \u092d\u0940 \u0915\u0941\u091b \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u0915\u093e \u0938\u093e\u092e\u0928\u093e \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u093e \u091c\u0948\u0938\u0947 \u0938\u0940\u090f\u0928\u090f\u0928 \u0915\u094b \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u092e\u0947\u0921\u093f\u0915\u0932 \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0921\u0947\u091f\u093e \u0915\u0940 \u092e\u093e\u0924\u094d\u0930\u093e, \u092e\u0947\u0921\u093f\u0915\u0932 \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0921\u0947\u091f\u093e \u0915\u0940 \u0932\u0947\u092c\u0932\u093f\u0902\u0917 \u0906\u0926\u093f\u0964 \u0907\u0928 \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u0928\u0947 \u0911\u091f\u094b\u090f\u0928\u0915\u094b\u0921\u0930 \u0914\u0930 \u0921\u093f\u0915\u094b\u0921\u0930, \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0914\u0930 \u091c\u0947\u0928\u0930\u0947\u091f\u093f\u0935 \u090f\u0921\u0935\u0930\u094d\u0938\u093f\u092f\u0932 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u091c\u0948\u0938\u0940 \u0928\u0908 \u0924\u0915\u0928\u0940\u0915\u094b\u0902 \u0915\u094b \u091c\u0928\u094d\u092e \u0926\u093f\u092f\u093e\u0964 (\u091c\u0940\u090f\u090f\u0928)\u0964 \u090f\u0928\u0915\u094b\u0921\u0930 \u0914\u0930 \u0921\u093f\u0915\u094b\u0921\u0930 \u092a\u093f\u091b\u0932\u0947 \u0905\u0928\u0941\u092d\u0935 \u092f\u093e \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0907\u0928\u092a\u0941\u091f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0909\u0928\u094d\u0939\u0947\u0902 \u0926\u0940 \u0917\u0908 \u091b\u0935\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u0947\u092c\u0932 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u0923 \u0936\u093f\u0915\u094d\u0937\u0923 \u0928\u0947 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u092e \u0938\u0902\u0916\u094d\u092f\u093e \u092e\u0947\u0902 \u091b\u0935\u093f\u092f\u094b\u0902 \u0914\u0930 \u0921\u0947\u091f\u093e \u0915\u0940 \u0932\u0947\u092c\u0932\u093f\u0902\u0917 \u091c\u0948\u0938\u0940 \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u0915\u093e \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u093f\u092f\u093e\u0964 \u091c\u0940\u090f\u090f\u0928 \u0928\u0947 \u092e\u0942\u0932 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0921\u0947\u091f\u093e \u0915\u0940 \u0924\u0930\u0939 \u0926\u093f\u0916\u0928\u0947 \u0914\u0930 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u0902\u0935\u0930\u094d\u0927\u093f\u0924 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u091b\u0935\u093f\u092f\u093e\u0902 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u0915\u0947 \u091b\u094b\u091f\u0947 \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0921\u0947\u091f\u093e\u0938\u0947\u091f \u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u094b \u0939\u0932 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0940\u0964 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u091b\u0935\u093f \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u0928\u0935\u0940\u0928\u0924\u092e \u092a\u094d\u0930\u0917\u0924\u093f \u0917\u0939\u0928 \u0936\u093f\u0915\u094d\u0937\u0923 \u092e\u0949\u0921\u0932 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0914\u0930 \u092a\u0930\u093f\u0936\u094b\u0927\u0928 \u0939\u0948\u0964 \u0921\u0940\u092a \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u092e\u0949\u0921\u0932 \u092c\u0939\u0941\u0924 \u0915\u092e \u0938\u092e\u092f \u092e\u0947\u0902 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0935\u093f\u0936\u0947\u0937\u091c\u094d\u091e\u094b\u0902 \u0915\u0947 \u0938\u092e\u093e\u0928 \u0909\u091a\u094d\u091a \u0938\u091f\u0940\u0915\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u091b\u0935\u093f\u092f\u094b\u0902 \u0915\u093e \u0928\u093f\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0939\u0948\u0902\u0964 \u0939\u093e\u0932 \u0915\u0947 \u0935\u093f\u0915\u093e\u0938 \u091c\u0948\u0938\u0947 \u0906\u0902\u0924\u0930\u093f\u0915 \u0936\u0930\u0940\u0930 \u0915\u0947 \u0905\u0902\u0917\u094b\u0902 \u0938\u0947 \u092c\u093f\u0928\u093e \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0947 \u090a\u0924\u0915 \u091b\u0935\u093f\u092f\u094b\u0902 \u0915\u093e \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u092c\u0939\u0941\u0924 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0935\u093f\u0915\u093e\u0938 \u0939\u0948\u0964 \u0917\u0939\u0928 \u0936\u093f\u0915\u094d\u0937\u0923 \u0924\u0915\u0928\u0940\u0915\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u090f \u0917\u090f \u0909\u091a\u094d\u091a \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u0935\u093e\u0932\u0947 \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0921\u0947\u091f\u093e \u0915\u0947 \u0938\u093e\u0925 \u0921\u0949\u0915\u094d\u091f\u0930 \u0936\u0930\u0940\u0930 \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0905\u0902\u0917 \u0915\u0947 \u0906\u0902\u0924\u0930\u093f\u0915 \u092f\u093e \u092c\u093e\u0939\u0930\u0940 \u0939\u093f\u0938\u094d\u0938\u0947 \u0915\u0940 \u0935\u093f\u0938\u094d\u0924\u093e\u0930 \u0938\u0947 \u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u092c \u0917\u0939\u0928 \u0936\u093f\u0915\u094d\u0937\u0923 \u092e\u0949\u0921\u0932 \u0915\u094b\u0936\u093f\u0915\u093e\u0913\u0902, \u0927\u092e\u0928\u093f\u092f\u094b\u0902, \u091f\u094d\u092f\u0942\u092e\u0930 \u0906\u0926\u093f \u091c\u0948\u0938\u0947 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u0915\u0940 \u0915\u0932\u094d\u092a\u0928\u093e \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0939\u0948\u0902 \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0909\u091a\u094d\u091a \u092a\u0930\u093f\u0936\u0941\u0926\u094d\u0927\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u091b\u0935\u093f\u092f\u094b\u0902 \u0938\u0947 \u0905\u0932\u0917 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0939\u0948\u0902\u0964",
            "size": 10.079999923706055,
            "font": "TimesNewRomanPSMT"
        },
