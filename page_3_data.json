        {
            "type": "text",
            "bbox": [
                42.50400161743164,
                288.23870849609375,
                570.0000610351562,
                325.7972717285156
            ],
            "text": "\u092f\u0939 \u0905\u0928\u0941\u092d\u093e\u0917 \u0907\u0938 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0932\u0947\u0916 \u0915\u0947 \u0926\u093e\u092f\u0930\u0947 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0939\u0948\u0964 \u0938\u094d\u0915\u094b\u092a \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u091b\u0935\u093f \u0915\u0947 \u092a\u094d\u0930\u0915\u093e\u0930, \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u0917\u090f \u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u092e\u0949\u0921\u0932, \u092a\u094d\u0930\u0940-\u092a\u094d\u0930\u094b\u0938\u0947\u0938\u093f\u0902\u0917 \u0924\u0915\u0928\u0940\u0915, \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0917\u0908 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0914\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0939\u0948\u0964 \u0916\u094b\u091c \u092e\u093e\u0928\u0926\u0902\u0921 \u0914\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u093f\u0902\u0917 \u092e\u093e\u0928\u0926\u0902\u0921 \u092a\u0930 \u092d\u0940 \u092c\u093e\u0926 \u0915\u0947 \u0909\u092a \u0905\u0928\u0941\u092d\u093e\u0917\u094b\u0902 \u092e\u0947\u0902 \u091a\u0930\u094d\u091a\u093e \u0915\u0940 \u0917\u0908 \u0939\u0948:",
            "size": 10.079999923706055,
            "font": "TimesNewRomanPSMT"
        },
        {
            "type": "text",
            "bbox": [
                60.50400161743164,
                338.0176086425781,
                571.3282470703125,
                373.7972717285156
            ],
            "text": "2.1. \u0938\u094d\u0915\u094b\u092a \u092a\u0939\u091a\u093e\u0928: \u0907\u0938 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u0924\u094c\u0930-\u0924\u0930\u0940\u0915\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0915\u0948\u0902\u0938\u0930 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0905\u0927\u094d\u092f\u092f\u0928\u094b\u0902 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0915\u0930\u0928\u093e \u0939\u0948\u0964 \u0907\u0938 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0905\u0927\u094d\u092f\u092f\u0928 \u0915\u093e \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u0926\u093e\u092f\u0930\u093e \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0936\u094b\u0927 \u092a\u094d\u0930\u0936\u094d\u0928\u094b\u0902 \u0915\u0947 \u0909\u0924\u094d\u0924\u0930 \u0922\u0942\u0902\u0922\u0928\u093e \u0939\u0948:",
            "size": 10.079999923706055,
            "font": "TimesNewRomanPS-BoldMT"
        },
        {
            "type": "text",
            "bbox": [
                60.50400161743164,
                384.1175842285156,
                491.8299865722656,
                429.7372741699219
            ],
            "text": "1. \u0915\u0948\u0902\u0938\u0930 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0915\u094c\u0928 \u0938\u0940 \u092e\u0947\u0921\u093f\u0915\u0932 \u0907\u092e\u0947\u091c\u093f\u0902\u0917 \u092a\u0926\u094d\u0927\u0924\u093f\u092f\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948? 2. \u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0906\u0927\u093e\u0930\u093f\u0924 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u092e\u0949\u0921\u0932 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094c\u0928 \u0938\u0947 \u092e\u0947\u0921\u093f\u0915\u0932 \u0907\u092e\u0947\u091c \u0921\u0947\u091f\u093e\u0938\u0947\u091f \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948? 3. \u092a\u0942\u0930\u094d\u0935-\u092a\u094d\u0930\u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0924\u0915\u0928\u0940\u0915\u0947\u0902 \u0915\u094d\u092f\u093e \u0939\u0948\u0902 \u0914\u0930 \u092f\u0939 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u094b \u0915\u0948\u0938\u0947 \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u0924\u0940 \u0939\u0948\u0902? 4. \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u092e\u0949\u0921\u0932 \u0915\u0947 \u092a\u0930\u093f\u0923\u093e\u092e\u094b\u0902 \u0915\u093e \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094c\u0928 \u0938\u0947 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928 \u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948?",
            "size": 10.079999923706055,
            "font": "TimesNewRomanPSMT"
        },
        {
            "type": "text",
            "bbox": [
                60.50400161743164,
                441.71759033203125,
                150.41000366210938,
                453.01727294921875
            ],
            "text": "2.2. \u0916\u094b\u091c \u092e\u093e\u0928\u0926\u0902\u0921:",
            "size": 10.079999923706055,
            "font": "TimesNewRomanPS-BoldMT"
        },
        {
            "type": "text",
            "bbox": [
                63.86399841308594,
                454.8387145996094,
                571.7884521484375,
                532.2373046875
            ],
            "text": "\u0907\u0938 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u092a\u0924\u094d\u0930 \u092e\u0947\u0902, \u0939\u092e\u093e\u0930\u093e \u0932\u0915\u094d\u0937\u094d\u092f \u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u0924\u0915\u0928\u0940\u0915\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u0915\u0948\u0902\u0938\u0930 \u0914\u0930 \u0907\u0938\u0915\u0947 \u0928\u093f\u0926\u093e\u0928 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0905\u0927\u094d\u092f\u092f\u0928\u094b\u0902 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0915\u0930\u0928\u093e \u0914\u0930 \u0909\u0928\u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0928\u093e \u0939\u0948\u0964 \u0907\u0938 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u092a\u0924\u094d\u0930 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0932\u0947\u0916\u094b\u0902 \u0915\u094b \u0924\u093e\u0932\u093f\u0915\u093e 1 \u092e\u0947\u0902 \u0926\u093f\u090f \u0917\u090f \u0915\u0941\u091b \u0915\u0940\u0935\u0930\u094d\u0921 \u0914\u0930 \u0916\u094b\u091c \u092e\u093e\u0928\u0926\u0902\u0921\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0916\u094b\u091c\u093e \u0914\u0930 \u091a\u0941\u0928\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0932\u0947\u0916\u094b\u0902 \u0915\u094b \u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917\u0930 \u0932\u093f\u0902\u0915, \u0938\u093e\u0907\u0902\u0938 \u0921\u093e\u092f\u0930\u0947\u0915\u094d\u091f, \u0906\u0908\u0908\u0908\u0908 \u090f\u0915\u094d\u0938\u092a\u094d\u0932\u094b\u0930, \u092a\u092c\u092e\u0947\u0921 \u0907\u0924\u094d\u092f\u093e\u0926\u093f \u091c\u0948\u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093f\u0924 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u0947 \u0916\u094b\u091c\u093e \u0914\u0930 \u090f\u0915\u0924\u094d\u0930 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0936\u0941\u0930\u0941\u0906\u0924 \u092e\u0947\u0902 \u0915\u0941\u0932 3058 \u0936\u094b\u0927 \u0932\u0947\u0916\u094b\u0902 \u0915\u093e \u091a\u092f\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \u0932\u0947\u0915\u093f\u0928 \u0907\u0928 \u0932\u0947\u0916\u094b\u0902 \u0915\u0940 \u0938\u093e\u0935\u0927\u093e\u0928\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u091c\u093e\u0902\u091a \u0915\u0930\u0928\u0947 \u092a\u0930 \u091a\u093f\u0924\u094d\u0930 3 \u092e\u0947\u0902 \u0926\u0930\u094d\u0936\u093e\u090f \u0917\u090f \u092b\u094d\u0932\u094b\u091a\u093e\u0930\u094d\u091f \u092e\u0947\u0902 \u0926\u093f\u0916\u093e\u090f \u0917\u090f \u0939\u092e\u093e\u0930\u0947 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u093f\u0902\u0917 \u092e\u093e\u0928\u0926\u0902\u0921\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0915\u0947\u0935\u0932 137 \u0932\u0947\u0916\u094b\u0902 \u0915\u093e \u091a\u092f\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964",
