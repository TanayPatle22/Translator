                508.9898986816406
            ],
            "text": "\u0915\u093e\u0917\u091c\u093c\u0964",
            "size": 9.119999885559082,
            "font": "TimesNewRomanPSMT"
        },
        {
            "type": "text",
            "bbox": [
                63.86399841308594,
                521.0787353515625,
                572.02001953125,
                704.1293334960938
            ],
            "text": "\u090f\u0932\u094d\u0938\u0947\u0935\u093f\u092f\u0930, \u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917\u0930 \u0932\u093f\u0902\u0915, \u0906\u0908\u0908\u0908\u0908 \u090f\u0915\u094d\u0938\u092a\u094d\u0932\u094b\u0930 \u0914\u0930 \u092a\u092c\u092e\u0947\u0921 \u091c\u0948\u0938\u0947 \u0938\u092d\u0940 \u092a\u094d\u0930\u092e\u0941\u0916 \u0914\u0930 \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093f\u0924 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0924\u093e\u0932\u093f\u0915\u093e 1 \u092e\u0947\u0902 \u0909\u0932\u094d\u0932\u093f\u0916\u093f\u0924 \u0935\u093f\u0936\u0947\u0937 \u0915\u0940\u0935\u0930\u094d\u0921 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0916\u094b\u091c\u0947 \u0917\u090f \u0925\u0947\u0964 \u0915\u0947\u0935\u0932 \u0909\u0928 \u091c\u0930\u094d\u0928\u0932 \u0932\u0947\u0916\u094b\u0902, \u0938\u092e\u094d\u092e\u0947\u0932\u0928 \u092a\u0924\u094d\u0930\u094b\u0902 \u0914\u0930 \u0905\u0927\u094d\u092f\u093e\u092f\u094b\u0902 \u0915\u094b \u0905\u0902\u0924\u093f\u092e \u0938\u0902\u0917\u094d\u0930\u0939 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u091c\u094b \u091a\u093f\u0924\u094d\u0930 3 \u092b\u093c\u094d\u0932\u094b\u091a\u093e\u0930\u094d\u091f \u092e\u0947\u0902 \u0928\u093f\u0930\u094d\u0926\u093f\u0937\u094d\u091f \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u094b \u092a\u0942\u0930\u093e \u0915\u0930\u0924\u0947 \u0925\u0947\u0964 \u092c\u0939\u0941\u0924 \u0938\u093e\u0930\u0947 \u0905\u0928\u093e\u0935\u0936\u094d\u092f\u0915 \u0932\u0947\u0916\u094b\u0902 \u0915\u094b \u092d\u0940 \u092c\u093e\u0939\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u090f\u0915 \u0939\u0940 \u0932\u0947\u0916 \u090f\u0915 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092e\u0947\u0902 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092a\u0924\u094d\u0930\u093f\u0915\u093e\u0913\u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0939\u0941\u090f \u0925\u0947\u0964 \u0907\u0938\u0915\u0947 \u0905\u0932\u093e\u0935\u093e, \u0915\u0941\u091b \u0915\u093e\u0917\u091c\u093e\u0924 \u0905\u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092a\u093e\u090f \u0917\u090f \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0935\u0947 \u0915\u0902\u092a\u094d\u092f\u0942\u091f\u0930 \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0915\u0947 \u092c\u091c\u093e\u092f \u0936\u0941\u0926\u094d\u0927 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0925\u0947 \u0907\u0938\u0932\u093f\u090f \u0909\u0928 \u0932\u0947\u0916\u094b\u0902 \u0915\u094b \u092d\u0940 \u0905\u0902\u0924\u093f\u092e \u0938\u0902\u0917\u094d\u0930\u0939 \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0916\u093e\u0930\u093f\u091c \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0915\u0941\u091b \u0932\u0947\u0916 \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940 \u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u0905\u0928\u094d\u092f \u092d\u093e\u0937\u093e\u0913\u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0939\u0941\u090f \u0925\u0947 \u0907\u0938\u0932\u093f\u090f \u0909\u0928 \u0932\u0947\u0916\u094b\u0902 \u0915\u094b \u0939\u092e\u093e\u0930\u0947 \u0932\u0947\u0916\u094b\u0902 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e \u0938\u0902\u0917\u094d\u0930\u0939 \u0938\u0947 \u092d\u0940 \u092c\u093e\u0939\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0915\u0941\u091b \u0932\u0947\u0916 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0925\u0947 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0915\u0947\u0935\u0932 \u0909\u0928\u0915\u093e \u0938\u093e\u0930 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e \u0910\u0938\u0947 \u0932\u0947\u0916\u094b\u0902 \u0915\u094b \u0932\u0947\u0916\u094b\u0902 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e \u0938\u0902\u0917\u094d\u0930\u0939 \u0938\u0947 \u092d\u0940 \u092c\u093e\u0939\u0930 \u0930\u0916\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0915\u0941\u091b \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0914\u0930 \u0938\u0930\u094d\u0935\u0947\u0915\u094d\u0937\u0923 \u092a\u0924\u094d\u0930\u094b\u0902 \u0915\u094b \u092d\u0940 \u0938\u0902\u0917\u094d\u0930\u0939 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0930\u0916\u093e \u0917\u092f\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0935\u0947 \u092a\u0941\u0930\u093e\u0928\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e\u090f\u0901 \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924 \u0915\u0930\u0924\u0947 \u0925\u0947 \u092f\u093e \u0909\u0928\u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0902\u092a\u094d\u092f\u0942\u091f\u0930 \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0921\u094b\u092e\u0947\u0928 \u0915\u0947 \u092c\u091c\u093e\u092f \u0936\u0941\u0926\u094d\u0927 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0935\u093f\u091c\u094d\u091e\u093e\u0928 \u0921\u094b\u092e\u0947\u0928 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0925\u0940\u0964 \u0915\u0941\u091b \u0936\u094b\u0927 \u0932\u0947\u0916\u094b\u0902 \u092e\u0947\u0902 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u092e\u0936\u0940\u0928 \u0932\u0930\u094d\u0928\u093f\u0902\u0917 \u090f\u0932\u094d\u0917\u094b\u0930\u093f\u0926\u092e \u0914\u0930 \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u0935\u093f\u0915\u093e\u0930\u094b\u0902 \u092a\u0930 \u0909\u0928\u0915\u0947 \u0905\u0928\u0941\u092a\u094d\u0930\u092f\u094b\u0917\u094b\u0902 \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0936\u093e\u092e\u093f\u0932 \u0925\u093e \u0932\u0947\u0915\u093f\u0928 \u092f\u0947 \u0932\u0947\u0916 \u0915\u0947\u0935\u0932 \u0915\u0948\u0902\u0938\u0930 \u092a\u0930 \u0939\u0940 \u0928\u0939\u0940\u0902 \u092c\u0932\u094d\u0915\u093f \u0905\u0928\u094d\u092f \u092c\u0940\u092e\u093e\u0930\u093f\u092f\u094b\u0902 \u092a\u0930 \u092d\u0940 \u0927\u094d\u092f\u093e\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0924\u0947 \u0925\u0947 \u0907\u0938\u0932\u093f\u090f \u0910\u0938\u0947 \u0932\u0947\u0916\u094b\u0902 \u0915\u094b \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0936\u094b\u0927 \u0932\u0947\u0916\u094b\u0902 \u0915\u0947 \u0909\u092a\u0930\u094b\u0915\u094d\u0924 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0915\u094b \u0916\u094b\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0902\u092f\u094b\u091c\u0928 \u092e\u0947\u0902 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0916\u094b\u091c \u0915\u0940\u0935\u0930\u094d\u0921 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092e\u0947\u0902 \u0932\u0947\u0916\u094b\u0902 \u0915\u0940 \u0916\u094b\u091c \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u0940\u0935\u0930\u094d\u0921 \u0914\u0930 \u091c\u093f\u0928 \u092a\u0924\u094d\u0930\u093f\u0915\u093e\u0913\u0902 \u0938\u0947 \u0932\u0947\u0916 \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u090f \u0917\u090f \u0925\u0947, \u0909\u0928\u094d\u0939\u0947\u0902 \u0924\u093e\u0932\u093f\u0915\u093e 1 \u092e\u0947\u0902 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0